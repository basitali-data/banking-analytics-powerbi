{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.14.0/schema.json",
  "name": "l1",
  "position": {
    "x": 20,
    "y": 180,
    "z": 0,
    "height": 420,
    "width": 1180
  },
  "visual": {
    "visualType": "lineChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "dim_date"
                    }
                  },
                  "Property": "month_start"
                }
              },
              "queryRef": "dim_date.month_start",
              "nativeQueryRef": "month_start",
              "active": true
            }
          ]
        },
        "Series": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_loan_portfolio"
                    }
                  },
                  "Property": "product"
                }
              },
              "queryRef": "fact_loan_portfolio.product",
              "nativeQueryRef": "product"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "fact_loan_portfolio"
                    }
                  },
                  "Property": "PAR 30+ %"
                }
              },
              "queryRef": "fact_loan_portfolio.PAR 30+ %",
              "nativeQueryRef": "PAR 30+ %"
            }
          ]
        }
      }
    },
    "visualContainerObjects": {
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'PAR 30+ trend by product'"
                }
              }
            }
          }
        }
      ]
    }
  }
}