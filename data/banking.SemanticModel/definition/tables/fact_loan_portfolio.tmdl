table fact_loan_portfolio
	lineageTag: 91df990b-0731-453e-92b8-abe42017d983

	measure 'Outstanding (AED)' = SUM(fact_loan_portfolio[outstanding_aed])
		formatString: #,0
		lineageTag: 0a398e0c-83a7-411c-8d8f-309ee72d8e86

	measure 'PAR 30+ %' = DIVIDE(SUM(fact_loan_portfolio[dpd_30_89_aed]) + SUM(fact_loan_portfolio[dpd_90_plus_aed]), [Outstanding (AED)])
		formatString: 0.0%
		lineageTag: 25963056-f185-494c-aa64-137e76829a8e

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'NPL 90+ %' = DIVIDE(SUM(fact_loan_portfolio[dpd_90_plus_aed]), [Outstanding (AED)])
